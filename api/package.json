    "scripts": {
        "start": "tsx watch --import=./src/register-crash-logger.ts ./src/index.ts",
        "test": "tsx --test --test-global-setup=./test/setup/global-setup.mjs --import=./test/setup/log-level.ts --import=./test/setup/worker-db.ts 'test/**/*.test.ts'",
        "mikro-orm": "tsx ./node_modules/@mikro-orm/cli/cli",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit",
        "build": "tsc -p tsconfig.build.json",
        "openapi": "tsx scripts/emit-openapi.ts",
        "config-schema": "tsx scripts/emit-config-schema.ts"
    },
    "mikro-orm": {
        "configPaths": [
            "./src/mikro-orm.config.ts",
            "./mikro-orm.config.js"
        ]
